{
  "name": "historygame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "마스킹된 역사 장면에서 의사결정자가 되어 판단하는 정적 웹 게임",
  "scripts": {
    "dev": "npm run build:scenarios && vite",
    "build:scenarios": "tsx scripts/build-scenarios.ts",
    "build": "npm run build:scenarios && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "tsx scripts/validate.ts",
    "check-urls": "tsx scripts/check-urls.ts",
    "linkrot": "tsx scripts/linkrot.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
